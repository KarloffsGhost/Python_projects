# Log files
*.log
UpdateCheck_*.log

# Windows thumbnail cache and system files
Thumbs.db
desktop.ini
*.lnk

# PowerShell profile backups
*_profile.ps1

# User-specific files (don't commit personal configs)
*.bak
*.tmp
*.temp

# IDE and editor files
.vscode/
.idea/
.claude/
*.suo
*.user

# Windows specific
$RECYCLE.BIN/
System Volume Information/

# Runtime state - machine-specific scan results, recreated on demand
Data/

# Generated output - recreated on demand
Reports/
DriverBackups/

# Backups of disabled startup entries (contains local paths and app names)
Config/startup-backup/
